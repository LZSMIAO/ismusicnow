# Node.js 22.17+，pnpm 10；只在服務端配置，不要提交真實憑證。
HOST=localhost
PORT=3000
ORIGIN=http://localhost:3000
DATA_DIR=.data

# MyHK 六平台主接口（密鑰只放服務端，留空停用）。
MYHK_API_KEY=

# 網易雲帳號。支援原 MUSIC_U，或填完整 NETEASE_COOKIE。
MUSIC_U=
NETEASE_COOKIE=
# 可選：自建的標準網易雲 API 地址。留空使用內置 SDK。
NETEASE_API_URL=

# Spotify 元資料：搜尋、專輯、歌單；單曲連結可用公開 oEmbed。
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# 可選：有相應歌單權限的官方使用者 access token（過期需更新）。
SPOTIFY_ACCESS_TOKEN=

# Spotify 原始音源：不匹配其他平台、不轉碼。
VOTIFY_BIN=.venv/bin/votify
SPOTIFY_COOKIES_PATH=secrets/spotify-cookies.txt
SPOTIFY_AUDIO_QUALITY=vorbis-high
# 可選：AAC/FLAC 或 desktop session 所需的 Votify 配置。
VOTIFY_CONFIG_PATH=

# YTM 是獨立來源，直接保存 bestaudio 原始容器。
YTDLP_BIN=.venv/bin/yt-dlp
YTM_COOKIES_PATH=
# Optional outside Docker: Python interpreter with ytmusicapi installed.
YTM_PYTHON_BIN=

# Telegram bot 可單獨啟動，不依賴網頁服務。
BOT_TOKEN=
# 私有 Telegram 快取頻道的數字 ID（如 -1001234567890）。
# 將 bot 設為頻道管理員並開啟「發佈訊息」；首次 Inline 播放需要此設定。
BOT_CACHE_CHAT_ID=
# 可選：指定 Bot 專用映像，避免更新 Bot 時改動網頁映像。
BOT_IMAGE=
# Telegram Mini App：bot 選單與 /app，必須使用公網 HTTPS 網址。
BOT_WEB_APP_URL=https://music.ism.tw
# 建議限定使用者，用逗號分隔 Telegram user ID。空白代表公開 bot。
BOT_ALLOWED_USERS=

# 公網部署時可設定 HTTP Basic Auth；本地預設不需要。
HTTP_AUTH_USER=
HTTP_AUTH_PASSWORD=

# Spotify 每 IP 每日 5 首完整在線播放（UTC+8 00:00 重置）。
# 僅限由私人反向代理覆寫的標頭；未設定時使用直接連線 IP。
SPOTIFY_LISTEN_IP_HEADER=

# Optional public audio adapter cookies, stored server-side only
SOUNDCLOUD_COOKIES_PATH=
BANDCAMP_COOKIES_PATH=
BILIBILI_COOKIES_PATH=
